# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables (set on your server / Railway / Render / etc.)
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-<your-key-here>

# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables (set in Vercel project settings)
# ─────────────────────────────────────────────────────────────────────────────

# URL of the deployed FastAPI backend
# e.g. https://ecb-evaluator-backend.railway.app
BACKEND_URL=https://<your-backend-url>
