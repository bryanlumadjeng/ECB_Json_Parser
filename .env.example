# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables (set on your server / Railway / Render / etc.)
# ─────────────────────────────────────────────────────────────────────────────

# Azure OpenAI / Copilot Studio endpoint (Chat Completions format)
# Example for Azure OpenAI:
COPILOT_ENDPOINT=https://<your-resource>.openai.azure.com/openai/deployments/<deployment-name>/chat/completions?api-version=2024-08-01-preview

# API key for the endpoint above
COPILOT_API_KEY=<your-azure-openai-or-copilot-studio-api-key>

# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables (set in Vercel project settings)
# ─────────────────────────────────────────────────────────────────────────────

# URL of the deployed FastAPI backend
# e.g. https://ecb-evaluator-backend.railway.app
# or   https://ecb-evaluator.onrender.com
BACKEND_URL=https://<your-backend-url>
